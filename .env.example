# ==============================================================================
# Linmour Restaurant SaaS Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Note: NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Database Configuration (MySQL 8.0)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# Redis Configuration (Redis 6.x+)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=2

# Security & Authentication
# JWT Secret for merchant / user authentication (minimum 32 characters)
JWT_SECRET=your_jwt_secret_token_here_at_least_32_characters
# Shared token for internal microservice Feign communication (64 hex characters)
INTERNAL_TOKEN=your_internal_service_token_here_64_hex_chars
# Master encryption key for PayOS config secrets (AES-GCM 256-bit, at least 32 characters)
PAYOS_CONFIG_SECRET=your_payos_config_secret_at_least_32_characters
# Master encryption key for OTP secrets (AES-GCM 256-bit, at least 32 characters)
OTP_SECRET=your_otp_secret_at_least_32_characters
# Secret key for signing tableAccessToken (HMAC-SHA256, at least 32 characters)
TABLE_TOKEN_SECRET=your_table_token_secret_at_least_32_characters
# Require platform admin to have 2FA/OTP enabled (default true; set false ONLY in local dev / e2e)
SECURITY_REQUIRE_OTP_FOR_PLATFORM_ADMIN=true
# Force weak passwords to be changed upon login (default true; set false ONLY in local dev / e2e)
SECURITY_FORCE_WEAK_PASSWORD_CHANGE=true
# Allow legacy client URLs with raw shopId & tableId query params (default false; set true ONLY in local dev)
SECURITY_ALLOW_RAW_TABLE_IDS=false

# Network & Base URLs (LAN IP or public domain)
LAN_IP=127.0.0.1
WEB_BASE_URL=http://127.0.0.1:5181
PUBLIC_BASE_URL=http://127.0.0.1:12800

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Object Storage (MinIO)
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=linmourscanorder
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_READ_PATH=http://127.0.0.1:9000

# Payment Gateway (PayOS) Mock Mode
# Set to 'true' ONLY in local development or automated E2E testing environments
# where simulated payments (mock QR, auto-completion, mock webhook) are required.
# WARNING: NEVER set to 'true' in production or staging environments with real payments!
# Defaults to 'false' if omitted.
PAYOS_MOCK=false

